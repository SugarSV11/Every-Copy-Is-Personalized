diff --git a/src/game/main.c b/src/game/main.c
index 4d8bf9b..0601531 100644
--- a/src/game/main.c
+++ b/src/game/main.c
@@ -452,9 +452,42 @@ void thread1_idle(UNUSED void *arg) {
     }
 }
 
+#ifdef LIVING_ROM
+/* PI registers (uncached KSEG1); rcp.h is not included because it redefines RDRAM_END */
+#define LIVING_PI_REG(o) (*(volatile u32 *) (0xA4600000 + (o)))
+extern u32 osVirtualToPhysical(void *);
+extern u8 _mainSegmentStart[];
+extern u8 _mainSegmentEnd[];
+extern u8 _mainSegmentRomStart[];
+#define LIVING_IPL3_LOAD_SIZE 0x100000
+static void living_load_main_tail(void) {
+    u32 size = (u32) _mainSegmentEnd - (u32) _mainSegmentStart;
+    u8 *dest;
+    u32 len;
+
+    if (size <= LIVING_IPL3_LOAD_SIZE) {
+        return;
+    }
+    dest = _mainSegmentStart + LIVING_IPL3_LOAD_SIZE;
+    len = size - LIVING_IPL3_LOAD_SIZE;
+    while (LIVING_PI_REG(0x10) & 0x3) { /* PI status: DMA or IO busy */
+    }
+    LIVING_PI_REG(0x00) = osVirtualToPhysical(dest); /* DRAM address */
+    LIVING_PI_REG(0x04) = 0x10000000 + (u32) _mainSegmentRomStart + LIVING_IPL3_LOAD_SIZE; /* cart */
+    LIVING_PI_REG(0x0C) = len - 1; /* cart -> DRAM length */
+    while (LIVING_PI_REG(0x10) & 0x3) {
+    }
+    osInvalDCache(dest, len);
+    osInvalICache(dest, len);
+}
+#endif
+
 void main_func(void) {
     UNUSED u8 filler[64];
 
+#ifdef LIVING_ROM
+    living_load_main_tail();
+#endif
     osInitialize();
     stub_main_1();
     create_thread(&gIdleThread, 1, thread1_idle, NULL, gIdleThreadStack + 0x800, 100);
